<Window x:Class="ScreenTranslator.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Cursor="Cross" WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        KeyDown="OnKeyDown">
	<Canvas Background="#01000000">
		<Rectangle x:Name="SelectionRect" Stroke="DodgerBlue" StrokeThickness="2"
                   Fill="#2200BFFF" Visibility="Collapsed"/>
	</Canvas>
</Window>