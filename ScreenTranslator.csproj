<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PlatformTarget>x64</PlatformTarget>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- если подключал иконку, верни эти две строки:
    <ApplicationIcon>app.ico</ApplicationIcon>
    -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="8.0.7" />
		<PackageReference Include="PaddleOCRSharp" Version="6.2.0" />
		<!-- если подключал иконку, верни: <Resource Include="app.ico" /> -->
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="words.txt" LogicalName="ScreenTranslator.words.txt" />
		<None Update="words.txt" CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
		<None Update="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- нативки Paddle: автоматически раскладываются рядом с exe -->
	<ItemGroup>
		<None Include="$(NuGetPackageRoot)paddle.runtime.win_x64\3.3.0.1\build\win_x64\**\*"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="$(NuGetPackageRoot)paddleocrsharp\6.2.0\build\**\*"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
